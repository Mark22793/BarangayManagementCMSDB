@model IEnumerable<BarangayCMS.Entities.BarangayOfficial>
@using BarangayCMS.Web.Areas.Admin.Services
@{
    var people = (Model ?? Enumerable.Empty<BarangayCMS.Entities.BarangayOfficial>()).ToList();
    var title = ViewData["ServantsTitle"] as string ?? "Your Public Servants";
    var leadId = ViewData["ServantsLeadId"] as int?;
    var exOfficioId = ViewData["ServantsExOfficioId"] as int?;

    // Hanapin ang Kapitan para ihiwalay sa itaas (Hero position)
    var captain = people.FirstOrDefault(o => (leadId.HasValue && o.BarangayOfficialId == leadId.Value)
                                           || (o.Position != null && o.Position.Contains("Captain", StringComparison.OrdinalIgnoreCase)));

    // Ang natitirang mga opisyal sa ibaba (Secretary, Treasurer, Kagawad)
    var council = captain != null ? people.Where(o => o.BarangayOfficialId != captain.BarangayOfficialId).ToList() : people;
}

@if (people.Any())
{
    <section class="servants-section container py-4">
        <div class="servants-heading text-center mb-5">
            <h2 class="servants-heading__title fw-bold text-uppercase tracking-wide">@title</h2>
        </div>

        @* --- BARANGAY CAPTAIN (Nasa Itaas / Center) --- *@
        @if (captain != null)
        {
            var captainViewData = new ViewDataDictionary(ViewData);
            captainViewData["Featured"] = true;
            captainViewData["ExOfficio"] = exOfficioId.HasValue && captain.BarangayOfficialId == exOfficioId.Value;

            <div class="d-flex justify-content-center mb-5">
                <div style="width: 100%; max-width: 380px;">
                    @await Html.PartialAsync("_PublicOfficialCard", captain, captainViewData)
                </div>
            </div>
        }

        @* --- IBANG OPISYAL GRID (Nasa Ibaba) --- *@
        @if (council.Any())
        {
            <div class="row g-4 justify-content-center">
                @foreach (var o in council)
                {
                    var memberViewData = new ViewDataDictionary(ViewData);
                    memberViewData["Featured"] = false;
                    memberViewData["ExOfficio"] = exOfficioId.HasValue && o.BarangayOfficialId == exOfficioId.Value;

                    <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                        @await Html.PartialAsync("_PublicOfficialCard", o, memberViewData)
                    </div>
                }
            </div>
        }
    </section>
}