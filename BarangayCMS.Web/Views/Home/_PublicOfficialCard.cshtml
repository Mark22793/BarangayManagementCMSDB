@model BarangayCMS.Entities.BarangayOfficial
@{
    var featured = ViewData["Featured"] as bool? ?? false;
    var isExOfficio = ViewData["ExOfficio"] as bool? ?? false;

    string Initials(string name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpper();
        return (parts[0].Substring(0, 1) + parts[^1].Substring(0, 1)).ToUpper();
    }

    string DescribePosition(string? position)
    {
        var p = (position ?? string.Empty).ToLowerInvariant();
        var isSk = p.Contains("sk ") || p.StartsWith("sk") || p.Contains("kabataan") || p.Contains("youth");

        if (isSk)
        {
            if (p.Contains("chair"))
                return "Youth Leader — Leads the Sangguniang Kabataan and oversees youth programs.";
            if (p.Contains("secretary"))
                return "Handles SK records, documentation, and administrative support.";
            if (p.Contains("treasurer"))
                return "Manages SK financial records, funds, and disbursements.";
            return "Represents youth interests and participates in youth council decision-making.";
        }

        if (p.Contains("captain") || p.Contains("punong"))
            return "Executive Head — Leads the barangay government and oversees operations and public services.";
        if (p.Contains("secretary"))
            return "Manages barangay records, documentation, and official communications.";
        if (p.Contains("treasurer"))
            return "Manages barangay finances, collections, disbursements, and financial reports.";
        if (p.Contains("kagawad") || p.Contains("councilor") || p.Contains("konsehal"))
            return "Represents community interests and participates in legislative decision-making.";
        return "Serves the barangay and its residents in official duties and community programs.";
    }

    var hasHistory = Model.ServiceHistories != null && Model.ServiceHistories.Any();
    var committee = BarangayCMS.Web.Areas.Admin.Services.OfficialStructure.DisplayCommittee(Model.Position, Model.Committee);
}

<div class="official-card-flip @(featured ? "official-featured" : "")">
    <div class="card-flip-inner">
        <!-- HARAPAN NG CARD (Larawan + Pangalan sa Baba) -->
        <div class="card-flip-front">
            <div class="card-front-image">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImagePath))
                {
                    <img src="~/uploads/officials/@Model.ProfileImagePath" alt="Larawan ni @Model.FullName" loading="lazy" />
                }
                else
                {
                    <div class="card-front-initials">@Initials(Model.FullName)</div>
                }
                <div class="card-front-overlay">
                    <h3 class="card-front-name">@Model.FullName</h3>
                    <span class="card-front-pos">@Model.Position</span>
                </div>
            </div>
        </div>

        <!-- LIKOD NG CARD (Details Lang — Walang Larawan, Hindi Baliktad ang Text) -->
        <div class="card-flip-back">
            <h4 class="fw-bold mb-1">@Model.FullName</h4>
            <span class="badge bg-primary mb-2">@Model.Position</span>

            @if (isExOfficio)
            {
                <div class="small text-warning mb-2">
                    <i class="bi bi-link-45deg me-1"></i>Ex-Officio Member
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(committee))
            {
                <div class="small text-info mb-2 fw-semibold">
                    <i class="bi bi-diagram-3-fill me-1"></i>@committee
                </div>
            }

            <p class="text-white-50 small my-2">@DescribePosition(Model.Position)</p>

            <button type="button" class="btn btn-sm btn-outline-light mt-auto"
                    data-bs-toggle="modal" data-bs-target="#historyModal-@Model.BarangayOfficialId">
                <i class="bi bi-clock-history me-1"></i>@(hasHistory ? "View Service History" : "View Term")
            </button>
        </div>
    </div>
</div>