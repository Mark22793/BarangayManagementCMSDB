@model BarangayCMS.Web.Areas.Staff.ViewModels.HealthViewModel

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Health Record Details";
}

<div class="page-header mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h1 class="page-header__title fw-bold text-dark"><i class="bi bi-clipboard2-heart-fill text-danger me-2"></i>Medical Record Profile</h1>
        <p class="page-header__sub text-muted">Kumpletong medikal na tala para kay @Model.ResidentName.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Staff" asp-controller="Health" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary fw-semibold rounded-3"><i class="bi bi-pencil me-1"></i> Edit</a>
        <a asp-area="Staff" asp-controller="Health" asp-action="Index" class="btn btn-light border fw-semibold rounded-3"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <!-- Patient summary + vitals -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 text-center mb-4 rounded-3">
            <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger"
                 style="width:84px;height:84px;font-size:2.4rem;">
                <i class="bi bi-person-heart"></i>
            </div>
            <h4 class="fw-bold mb-1 text-dark">@Model.ResidentName</h4>
            <span class="badge bg-info-subtle text-info-emphasis rounded-pill w-auto mx-auto px-3 py-1 mb-2">@Model.HealthClassification</span>
            <div>
                @if (Model.IsVaccinated)
                {
                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill px-3 py-2"><i class="bi bi-shield-check me-1"></i>Vaccinated</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis rounded-pill px-3 py-2"><i class="bi bi-shield-x me-1"></i>Not Vaccinated</span>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm p-4 rounded-3">
            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-activity me-1"></i> Vital Signs</h6>
            <div class="row text-center g-2">
                <div class="col-4">
                    <div class="p-2 rounded-3 bg-light">
                        <div class="fw-bold fs-5 text-dark">@(Model.WeightKg > 0 ? Model.WeightKg.ToString("0.#") : "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">Weight (kg)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 rounded-3 bg-light">
                        <div class="fw-bold fs-5 text-dark">@(Model.HeightCm > 0 ? Model.HeightCm.ToString("0.#") : "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">Height (cm)</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="p-2 rounded-3 bg-light">
                        <div class="fw-bold fs-5 text-primary">@(Model.Bmi > 0 ? Model.Bmi.ToString("0.#") : "—")</div>
                        <div class="text-muted" style="font-size:.72rem;">BMI</div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                <span class="text-muted small">Blood Type</span>
                <span class="fw-bold text-dark">@(string.IsNullOrEmpty(Model.BloodType) ? "N/A" : Model.BloodType)</span>
            </div>
            <div class="d-flex justify-content-between mt-2">
                <span class="text-muted small">BMI Category</span>
                <span class="fw-semibold">@Model.BmiCategory</span>
            </div>
        </div>
    </div>

    <!-- Clinical details -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 mb-4 rounded-3">
            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-clipboard2-pulse me-1"></i> Consultation Details</h6>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="text-muted small">Medical Condition / Diagnosis</div>
                    <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.MedicalCondition) ? "None" : Model.MedicalCondition)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Attending Health Worker</div>
                    <div class="fw-semibold text-dark">@(string.IsNullOrEmpty(Model.AttendingHealthWorker) ? "—" : Model.AttendingHealthWorker)</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Last Check-up</div>
                    <div class="fw-semibold text-dark"><i class="bi bi-calendar-heart me-1 text-danger"></i>@Model.LastCheckupDate.ToString("MMMM dd, yyyy")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small">Date Recorded</div>
                    <div class="fw-semibold text-dark"><i class="bi bi-calendar3 me-1 text-primary"></i>@Model.DateRecorded.ToString("MMMM dd, yyyy")</div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm p-4 rounded-3">
            <h6 class="fw-bold text-uppercase text-muted small mb-3"><i class="bi bi-journal-medical me-1"></i> Remarks & Clinical Notes</h6>
            <p class="mb-0 text-dark" style="white-space:pre-line;">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "No additional clinical notes were recorded for this consultation." : Model.Remarks)</p>
        </div>
    </div>
</div>