@model BarangayCMS.Web.Areas.Staff.ViewModels.ComplaintViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Modify Logged Complaint Records";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="app-card app-card--pad p-4 bg-white rounded-3 shadow-sm">
        <h4 class="mb-3 fw-bold text-dark">
            <i class="bi bi-pencil-square text-warning me-2"></i>Modify Logged Complaint Records
        </h4>
        <p class="text-muted small mb-4">Update dispute descriptions, case subject, or tracking status.</p>

        <form asp-area="Staff" asp-controller="Complaints" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <!-- Complainant Name Section -->
            <div class="mb-3">
                <label class="form-label fw-bold small text-secondary">Complainant Name Reference</label>

                @if (Model.Subject != null && Model.Subject.StartsWith("CMP"))
                {
                    <div class="alert alert-info py-2 px-3 mb-2 rounded border small">
                        <i class="bi bi-person-fill me-2 text-primary"></i>Submitted Online By: <strong>@Model.ResidentFullName</strong>
                    </div>
                    <input type="hidden" asp-for="ResidentId" />
                }
                else
                {
                    <select asp-for="ResidentId" asp-items="@(ViewBag.ResidentsList as SelectList)" class="form-select">
                        <option value="">-- Select Complainant --</option>
                    </select>
                    <span asp-validation-for="ResidentId" class="text-danger small"></span>
                }
            </div>

            <!-- Subject -->
            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-bold small text-secondary">Subject / Case Matter</label>
                <input asp-for="Subject" class="form-control" readonly="@(Model.Subject != null && Model.Subject.StartsWith("CMP"))" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold small text-secondary">Narrative & Case Details</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <!-- Dates & Status -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="DateSubmitted" class="form-label fw-bold small text-secondary">Incident / Logged Date</label>
                    <input asp-for="DateSubmitted" class="form-control" type="date" />
                    <span asp-validation-for="DateSubmitted" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-bold small text-secondary">Case Tracking Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Pending">Pending</option>
                        <option value="Assigned">Assigned</option>
                        <option value="Ongoing">Ongoing</option>
                        <option value="Resolved">Resolved</option>
                        <option value="Dismissed">Dismissed</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-between border-top pt-3">
                <a asp-area="Staff" asp-controller="Complaints" asp-action="Index" class="btn btn-light border px-4 fw-semibold rounded-3">Discard Changes</a>
                <button type="submit" class="btn btn-warning text-dark fw-bold px-4 shadow-sm rounded-3">
                    <i class="bi bi-check-lg me-1"></i> Update Case File
                </button>
            </div>
        </form>
    </div>
</div>