@model BarangayCMS.Web.Areas.Staff.ViewModels.ComplaintViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Case Details";
}

<div class="container py-4" style="max-width: 750px;">
    <div class="app-card app-card--pad">
        <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-3">
            <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-file-earmark-text text-warning me-2"></i>Complaint Log Ledger Record</h4>
            <span class="badge bg-dark px-3 py-2 fs-6">@Model.Status</span>
        </div>

        <table class="table table-borderless align-middle fs-6">
            <tr>
                <td class="fw-bold text-muted" style="width: 35%;">Complainant:</td>
                <td class="fw-semibold text-dark">
                    @if (Model.Subject != null && Model.Subject.StartsWith("CMP"))
                    {
                        <i class="bi bi-globe me-1 text-primary"></i> 
                        @Model.ResidentFullName
                        <span class="badge bg-info text-dark fs-6 ms-2">Online Form</span>
                    }
                    else
                    {
                        @Model.ResidentFullName
                    }
                </td>
            </tr>
            <tr>
                <td class="fw-bold text-muted">Subject Head:</td>
                <td class="fw-bold text-primary">@Model.Subject</td>
            </tr>
            <tr>
                <td class="fw-bold text-muted">Date Submitted:</td>
                <td>@Model.DateSubmitted.ToString("MMMM dd, yyyy - hh:mm tt")</td>
            </tr>
        </table>

        <div class="mt-3">
            <p class="fw-bold text-muted mb-2">Narrative & Statements Summary Details:</p>
            <div class="p-3 bg-light rounded border text-dark" style="min-height: 120px; white-space: pre-wrap;">
                @Model.Description
            </div>
        </div>

        <!-- BUTTONS -->
        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
            <a asp-area="Staff" asp-controller="Complaints" asp-action="Index" class="btn btn-light border px-4 fw-semibold rounded-3">Back to Registry</a>
            <div class="d-flex gap-2">
                <a asp-area="Staff" asp-controller="Complaints" asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-outline-success px-4 rounded-3 fw-semibold">Shift State</a>
                <a asp-area="Staff" asp-controller="Complaints" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-dark fw-semibold px-4 rounded-3">Edit Records</a>
            </div>
        </div>
    </div>
</div>