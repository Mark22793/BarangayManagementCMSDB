@model BarangayCMS.Web.Areas.Staff.ViewModels.ComplaintViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Expunge Complaint File Entry";
}

<div class="container py-5" style="max-width: 550px;">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-header bg-danger text-white p-3 text-center">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-trash-fill me-2"></i>Expunge Complaint File Entry
            </h5>
        </div>
        
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>
                <h6 class="text-dark fw-bold mb-2">Are you absolutely sure you want to drop and erase this record summary tracking entry?</h6>
            </div>

            <div class="p-3 rounded-3 mb-3 bg-light border border-danger-subtle">
                <p class="mb-2 text-danger"><strong>Filer Faction:</strong> <span class="text-dark">@Model.ResidentFullName</span></p>
                <p class="mb-2 text-danger"><strong>Subject Matter:</strong> <span class="text-dark">#@Model.Subject</span></p>
                <p class="mb-0 text-danger"><strong>Current Track Status:</strong> <span class="badge bg-danger-subtle text-danger">@Model.Status</span></p>
            </div>

            <p class="text-muted text-center small mb-4">
                Removing active incident records compromises community record legal logs history consistency audits.
            </p>

            <form asp-area="Staff" asp-controller="Complaints" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ComplaintId" />

                <div class="d-flex justify-content-between border-top pt-3">
                    <a asp-area="Staff" asp-controller="Complaints" asp-action="Index" class="btn btn-light border px-4 fw-semibold rounded-3">Cancel Process</a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold rounded-3 shadow-sm">
                        <i class="bi bi-trash me-1"></i> Confirm Expunge
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>