@model IEnumerable<BarangayCMS.Web.Areas.Staff.ViewModels.ComplaintViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Complaints & Blotter Management";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-header__title"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Complaints & Blotter</h1>
        <p class="page-header__sub text-muted small mb-0">Track, review, and schedule hearings for incident blotters or citizen complaints.</p>
    </div>
    <a asp-area="Staff" asp-controller="Complaints" asp-action="Create" class="btn btn-warning text-dark shadow-sm fw-semibold rounded-3">
        <i class="bi bi-file-earmark-medical me-1"></i> File New Case
    </a>
</div>

<div class="app-card app-card--pad bg-white p-3 rounded-3 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Case ID / Subject</th>
                    <th>Complainant</th>
                    <th>Incident Details</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">#@item.Subject</td>
                            <td>
                                @if (item.Subject != null && item.Subject.StartsWith("CMP"))
                                {
                                    <span class="text-muted fst-italic"><i class="bi bi-globe me-1 text-primary"></i>Public Web Citizen</span>
                                }
                                else
                                {
                                    @item.ResidentFullName
                                }
                            </td>
                            <td class="text-truncate" style="max-width: 250px;">@item.Description</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
                                }
                                else if (item.Status == "Assigned" || item.Status == "Ongoing")
                                {
                                    <span class="badge bg-danger-subtle text-danger">@item.Status</span>
                                }
                                else if (item.Status == "Resolved")
                                {
                                    <span class="badge bg-success-subtle text-success">Resolved</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a asp-area="Staff" asp-controller="Complaints" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-area="Staff" asp-controller="Complaints" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Details">
                                        <i class="bi bi-info-circle"></i>
                                    </a>
                                    
                                    <!-- Dynamic Trigger Button para sa Bootstrap Modal -->
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-danger" 
                                            title="Delete Case"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#deleteConfirmModal" 
                                            data-id="@item.Id" 
                                            data-subject="@item.Subject">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-slash display-6 d-block mb-2 opacity-50"></i>
                            <span>No active barangay complaints or blotter cases logged.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 🔴 MODERN BOOTSTRAP DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body text-center p-4">
                <!-- Warning Icon -->
                <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                    <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                </div>

                <h4 class="fw-bold text-dark mb-2">Kumpirmahin ang Pagbura</h4>
                <p class="text-muted small mb-3">
                    Sigurado ka bang gusto mong burahin sa listahan ang case entry na <strong id="modalCaseSubject" class="text-dark"></strong>?
                </p>

                <form asp-area="Staff" asp-controller="Complaints" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalDeleteId" name="Id" value="" />

                    <div class="d-flex justify-content-center gap-2 mt-4 pt-2 border-top">
                        <button type="button" class="btn btn-light border px-4 fw-semibold rounded-3" data-bs-dismiss="modal">
                            Kanselahin
                        </button>
                        <button type="submit" class="btn btn-danger px-4 fw-bold rounded-3 shadow-sm">
                            <i class="bi bi-trash me-1"></i> Oo, Burahin
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Passes the specific item ID and Subject to the Modal dynamically
        const deleteModal = document.getElementById('deleteConfirmModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const subject = button.getAttribute('data-subject');

                document.getElementById('modalDeleteId').value = id;
                document.getElementById('modalCaseSubject').textContent = "#" + subject;
            });
        }
    </script>
}