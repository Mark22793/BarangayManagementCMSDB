@model BarangayManagementSystem.Areas.Staff.ViewModels.DashboardViewModel

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Staff Dashboard";
}

<div class="container-fluid p-0">

    <!-- 🌟 WELCOME BANNER (Dynamic User Name) -->
    <div class="welcome-banner">
        <span class="welcome-banner__eyebrow">Welcome Back,</span>
        <h1 class="welcome-banner__title" style="font-size: 2rem;">@(ViewData["UserFullName"] ?? "Staff / Encoder")!</h1>
        <p class="welcome-banner__text">
            This dashboard allows efficient monitoring and management of barangay operations, resident records, and documentation tracking.
        </p>
    </div>

    <!-- 🌟 SHORT & CLEAN DISASTER ALERT BANNER (PIC #2 STYLE) -->
    @if (!string.IsNullOrEmpty(Model.ActiveDisasterAlert))
    {
        <div class="alert alert-danger d-flex justify-content-between align-items-center shadow-sm border-0 rounded-3 my-3 px-3 py-2" style="background-color: #fde8e8; color: #e02424;">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-exclamation-triangle text-danger fs-5"></i>
                <span style="font-size: 0.95rem;">@Model.ActiveDisasterAlert</span>
            </div>
            <a href="/Staff/Disaster" class="text-danger fw-semibold text-decoration-none d-flex align-items-center gap-1" style="font-size: 0.9rem;">
                View <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    }

    <!-- 📊 STATS CARDS SECTION (Connected to DB) -->
    <div class="row g-3 mb-4">
        <!-- Total Residents Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card__icon"><i class="bi bi-people-fill"></i></div>
                <div>
                    <p class="stat-card__label">Total Residents</p>
                    <p class="stat-card__value">@Model.TotalResidents.ToString("N0")</p>
                </div>
            </div>
        </div>

        <!-- Pending Complaints Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card__icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div>
                    <p class="stat-card__label">Pending Complaints</p>
                    <p class="stat-card__value">@Model.ActiveBlotters.ToString("N0")</p>
                </div>
            </div>
        </div>

        <!-- Certificates Handled Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card__icon"><i class="bi bi-file-earmark-text-fill"></i></div>
                <div>
                    <p class="stat-card__label">Certificates Handled</p>
                    <p class="stat-card__value">@Model.PendingCertificates.ToString("N0")</p>
                </div>
            </div>
        </div>

        <!-- System Engine Card -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-card__icon"><i class="bi bi-cpu-fill"></i></div>
                <div>
                    <p class="stat-card__label">System Engine</p>
                    <p class="stat-card__value text-success">Operational</p>
                </div>
            </div>
        </div>
    </div>

</div>