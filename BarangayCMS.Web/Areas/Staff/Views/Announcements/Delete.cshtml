@model BarangayCMS.Web.Areas.Staff.ViewModels.AnnouncementViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Burahin ang Patalastas";
}

<div class="container py-4" style="max-width: 550px;">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-danger text-white p-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Babala: Pagtanggal ng Patalastas</h5>
        </div>
        <div class="card-body p-4">
            <h6 class="text-center text-dark fw-semibold mb-3">Sigurado ka bang gusto mong permanenteng burahin ang patalastas na ito?</h6>

            <div class="bg-light p-3 rounded-2 border mb-3">
                <div class="small text-muted text-uppercase fw-bold mb-1">Target Post Title</div>
                <div class="fw-bold text-dark">"@Model.Title"</div>
                <div class="small text-muted mt-1">Date Broadcasted: @Model.DatePosted.ToString("MMMM dd, yyyy")</div>
            </div>

            <p class="text-muted text-center small mb-0">Ang aksyon na ito ay permanente at hindi na pwedeng bawiin.</p>
        </div>
        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center">
            <a asp-action="Index" class="btn btn-light border px-4 fw-semibold rounded-3">Huwag Ituloy</a>
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="AnnouncementId" />
                <button type="submit" class="btn btn-danger px-4 fw-semibold rounded-3">Oo, Burahin Ito</button>
            </form>
        </div>
    </div>
</div>