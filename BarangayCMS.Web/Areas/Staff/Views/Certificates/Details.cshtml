@model BarangayCMS.Web.Areas.Staff.ViewModels.CertificateViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Certificate Details";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="app-card app-card--pad">
        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
            <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-file-earmark-text text-warning me-2"></i>Certificate Details</h4>
            <span class="badge bg-dark px-3 py-2 fs-6">@Model.Status</span>
        </div>

        <div class="card-body p-0">
            <table class="table table-borderless align-middle fs-6">
                <tr>
                    <td class="fw-bold text-muted" style="width: 35%;">Resident Name:</td>
                    <td class="fw-semibold text-dark">@Model.ResidentFullName</td>
                </tr>
                <tr>
                    <td class="fw-bold text-muted">Certificate Type:</td>
                    <td class="fw-semibold text-primary">@Model.CertificateType</td>
                </tr>
                @if (!string.IsNullOrWhiteSpace(Model.Purpose))
                {
                    <tr>
                        <td class="fw-bold text-muted">Purpose:</td>
                        <td class="fw-semibold text-dark">@Model.Purpose</td>
                    </tr>
                }
                <tr>
                    <td class="fw-bold text-muted">Date Requested:</td>
                    <td>@Model.DateRequested.ToString("MMMM dd, yyyy")</td>
                </tr>
                <tr>
                    <td class="fw-bold text-muted">Date Issued:</td>
                    <td>@(Model.DateIssued.HasValue ? Model.DateIssued.Value.ToString("MMMM dd, yyyy") : "Pending")</td>
                </tr>
            </table>

            <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                <a asp-area="Staff" asp-controller="Certificates" asp-action="Index" class="btn btn-light border px-4 fw-semibold rounded-3">
                    Back to List
                </a>

                @if (Model.Status == "Pending")
                {
                    <a asp-area="Staff" asp-controller="Certificates" asp-action="Approve" asp-route-id="@Model.Id" class="btn btn-success px-4 fw-bold rounded-3">
                        <i class="bi bi-check-circle me-1"></i> Approve Request
                    </a>
                }
                else
                {
                    <a asp-area="Staff" asp-controller="Certificates" asp-action="Print" asp-route-id="@Model.Id" target="_blank" class="btn btn-primary px-4 fw-bold rounded-3">
                        <i class="bi bi-printer me-1"></i> Generate / Print
                    </a>
                }
            </div>
        </div>
    </div>
</div>