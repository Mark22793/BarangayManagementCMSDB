@model IEnumerable<BarangayCMS.Web.Areas.Staff.ViewModels.CertificateViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Certificates Management";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-header__title"><i class="bi bi-file-earmark-text text-warning me-2"></i>Certificates Management</h1>
        <p class="page-header__sub text-muted small mb-0">Manage barangay clearances, indigency certificates, and document issuances.</p>
    </div>

    <div class="d-flex gap-2">
        <a href="/Staff/Certificates/Create" class="btn btn-warning text-dark shadow-sm fw-semibold rounded-3">
            <i class="bi bi-plus-lg me-1"></i> Issue New Certificate
        </a>
    </div>
</div>

<div class="app-card app-card--pad">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Document Type</th>
                    <th>Resident Name</th>
                    <th>Date Requested</th>
                    <th>Fee & Receipt</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@item.CertificateType</td>
                            <td>@item.ResidentFullName</td>
                            <td>@item.DateRequested.ToString("MM/dd/yyyy")</td>

                            <td>
                                @if (item.FeePaid > 0)
                                {
                                    <div class="d-flex flex-column align-items-start gap-1">
                                        <span class="badge bg-success-subtle text-success fw-bold">
                                            ₱@item.FeePaid.ToString("N2")
                                        </span>
                                        @if (!string.IsNullOrEmpty(item.PaymentReceiptPath))
                                        {
                                            <a href="@item.PaymentReceiptPath" target="_blank" class="small text-primary text-decoration-underline" style="font-size: 12px;">
                                                <i class="bi bi-receipt me-1"></i>View Receipt
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 11px; font-style: italic;">No Receipt Uploaded</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted">FREE</span>
                                }
                            </td>

                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">Pending</span>
                                }
                                else if (item.Status == "Success" || item.Status == "Issued" || item.Status == "Ready for Pickup")
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (item.Status == "Pending")
                                {
                                    <a href="/Staff/Certificates/Approve/@item.Id" class="btn btn-sm btn-outline-success me-1 fw-semibold">Approve</a>
                                }

                                <a href="/Staff/Certificates/Print/@item.Id"
                                   target="_blank"
                                   class="btn btn-sm btn-outline-primary me-1"
                                   title="Print Certificate Document"
                                   onclick="setTimeout(function(){ location.reload(); }, 1200);">
                                    <i class="bi bi-printer"></i>
                                </a>

                                <a href="/Staff/Certificates/Details/@item.Id" class="btn btn-sm btn-outline-info me-1" title="View"><i class="bi bi-info-circle"></i></a>
                                <a href="/Staff/Certificates/Delete/@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-file-earmark display-6 d-block mb-2 opacity-50"></i>
                            <span>No certificate requests found.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>