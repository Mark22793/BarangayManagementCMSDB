@model BarangayCMS.DTO.PublicEvacuationDTO
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Evacuation Center";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-house-door-fill text-danger me-2"></i>Evacuation Center Information
        </h2>
        <p class="text-muted small mb-0">Talaan at status ng mga pampublikong evacuation center sa barangay.</p>
    </div>
    <a asp-area="Staff" asp-controller="Disasters" asp-action="Index" class="btn btn-outline-secondary fw-semibold">
        <i class="bi bi-arrow-left me-1"></i> Bumalik sa Disaster Logs
    </a>
</div>

<!-- Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-light">
            <small class="text-muted fw-bold d-block mb-1">KABUUANG KAPASIDAD</small>
            <h4 class="fw-bold text-dark mb-0">@Model.TotalCapacity <span class="fs-6 text-muted font-normal">pamilya/indibidwal</span></h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-light">
            <small class="text-muted fw-bold d-block mb-1">KASALUKUYANG NAKALIKAS</small>
            <h4 class="fw-bold text-primary mb-0">@Model.TotalOccupants</h4>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-3 bg-light">
            <small class="text-muted fw-bold d-block mb-1">AVAILABLE SLOTS</small>
            <h4 class="fw-bold text-success mb-0">@Model.TotalAvailableSlots</h4>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pangalan ng Center</th>
                    <th>Lokasyon</th>
                    <th class="text-center">Kapasidad</th>
                    <th class="text-center">Occupants</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.ActiveCenters != null && Model.ActiveCenters.Any())
                {
                    @foreach (var center in Model.ActiveCenters)
                    {
                        var statusBadgeClass = center.OccupancyStatus?.ToUpper() switch
                        {
                            "OPEN" => "bg-success",
                            "NEAR CAPACITY" => "bg-warning text-dark",
                            "FULL" => "bg-danger",
                            "CLOSED" => "bg-secondary",
                            _ => "bg-info"
                        };

                        var locationDisplay = !string.IsNullOrWhiteSpace(center.SitioPurok) 
                            ? $"{center.Address} ({center.SitioPurok})" 
                            : center.Address;

                        <tr>
                            <td class="fw-semibold text-dark">@center.Name</td>
                            <td><i class="bi bi-geo-alt text-danger me-1"></i>@locationDisplay</td>
                            <td class="text-center">@center.Capacity</td>
                            <td class="text-center">@center.CurrentOccupants</td>
                            <td class="text-center">
                                <span class="badge @statusBadgeClass">@center.OccupancyStatus</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-building display-6 d-block mb-2 text-secondary"></i>
                            <span>Walang nakatala o available na active evacuation center sa kasalukuyan.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>