@model BarangayCMS.Areas.Staff.ViewModels.EnvironmentViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "I-edit ang Proyektong Pang-kapaligiran";
}

<div class="container py-4" style="max-width: 650px;">
    <div class="card border-0 shadow-sm p-4 rounded-3">
        <h5 class="fw-bold text-dark mb-1">
            <i class="bi bi-pencil-square text-success me-2"></i>Modify Activity Profile
        </h5>
        <p class="text-muted small mb-4">I-update ang iskedyul, lokasyon, o deskripsyon ng proyektong pang-kapaligiran.</p>

        <form asp-area="Staff" asp-controller="Environments" asp-action="Edit" asp-route-id="@Model.EnvironmentRecordId" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
            <input type="hidden" asp-for="EnvironmentRecordId" />

            <div class="mb-3">
                <label asp-for="ActivityName" class="form-label small fw-bold text-secondary"></label>
                <input asp-for="ActivityName" class="form-control form-control-sm" />
                <span asp-validation-for="ActivityName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label small fw-bold text-secondary"></label>
                <input asp-for="Location" class="form-control form-control-sm" />
                <span asp-validation-for="Location" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ActivityDate" class="form-label small fw-bold text-secondary"></label>
                <input asp-for="ActivityDate" class="form-control form-control-sm" type="datetime-local" />
                <span asp-validation-for="ActivityDate" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label small fw-bold text-secondary"></label>
                <textarea asp-for="Description" class="form-control form-control-sm" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-area="Staff" asp-controller="Environments" asp-action="Index" class="btn btn-sm btn-light border px-3">Discard Changes</a>
                <button type="submit" class="btn btn-sm btn-success px-4 fw-semibold">Update Record</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}