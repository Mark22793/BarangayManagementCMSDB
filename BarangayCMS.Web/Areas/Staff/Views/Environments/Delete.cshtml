@model BarangayCMS.Areas.Staff.ViewModels.EnvironmentViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Delete Environment Record";
}

<div class="container py-4" style="max-width: 600px;">
    <!-- Main Card -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden border-top border-danger border-5">
        <div class="card-body p-4 text-center">
            
            <!-- Warning Icon Header -->
            <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-trash3-fill fs-1"></i>
            </div>

            <h4 class="fw-bold text-dark mb-1">Alisin ang Eco Project Record na ito?</h4>
            <p class="text-muted small mb-4">
                Ang pagtanggal sa ecological record na ito ay permanenteng mag-aalis ng kasaysayan ng aktibidad na ito sa dashboard log at hindi na maibabalik.
            </p>

            <!-- Details Box -->
            <div class="bg-light p-3 rounded-3 mb-4 border text-start">
                <div class="row g-2 small">
                    <div class="col-sm-4 font-monospace text-muted fw-semibold">ACTIVITY NAME:</div>
                    <div class="col-sm-8 fw-bold text-dark">@(string.IsNullOrEmpty(Model?.ActivityName) ? "N/A" : Model.ActivityName)</div>

                    <div class="col-sm-4 font-monospace text-muted fw-semibold">LOCATION:</div>
                    <div class="col-sm-8 text-secondary">@(string.IsNullOrEmpty(Model?.Location) ? "N/A" : Model.Location)</div>

                    @if (Model != null && Model.ActivityDate != default)
                    {
                        <div class="col-sm-4 font-monospace text-muted fw-semibold">SCHEDULE:</div>
                        <div class="col-sm-8 text-secondary">@Model.ActivityDate.ToString("MMMM dd, yyyy - hh:mm tt")</div>
                    }

                    @if (!string.IsNullOrEmpty(Model?.Description))
                    {
                        <div class="col-sm-4 font-monospace text-muted fw-semibold">DETAILS:</div>
                        <div class="col-sm-8 text-secondary">@Model.Description</div>
                    }
                </div>
            </div>

            <!-- Action Form -->
            <form asp-action="Delete" asp-route-id="@Model?.EnvironmentRecordId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EnvironmentRecordId" />

                <div class="d-flex justify-content-center gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4 fw-semibold rounded-3">
                        <i class="bi bi-x-circle me-1"></i> Kanselahin
                    </a>
                    <button type="submit" class="btn btn-danger px-4 fw-bold rounded-3 shadow-sm">
                        <i class="bi bi-trash me-1"></i> Confirm Delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>