<script>
    (function () {
        var status = document.getElementById('statusText');

        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function stamp() {
            var d = new Date();
            return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
        }

        function downloadPdf() {
            var element = document.getElementById('reportContent');
            var opt = {
                margin:       [8, 8, 8, 8],
                filename:     'Barangay_Staff_Report_' + stamp() + '.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, backgroundColor: '#ffffff' },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak:    { mode: ['avoid-all', 'css', 'legacy'] }
            };

            if (typeof html2pdf === 'undefined') {
                window.print();
                return;
            }

            if (status) { status.textContent = 'Ginagawa ang PDF... maghintay lamang.'; }
            
            html2pdf().set(opt).from(element).save().then(function () {
                if (status) { status.textContent = 'Na-download na! Babalik na sa Dashboard... ✅'; }
                
                // ⏱️ Awtomatikong babalik sa Index page pagkatapos ng 1.5 segundo
                setTimeout(function() {
                    window.location.href = '@Url.Action("Index", "Reports", new { area = "Staff" })';
                }, 1500);

            }).catch(function () {
                if (status) { status.textContent = 'Nagka-problema — subukang muli ang Download button.'; }
            });
        }

        window.addEventListener('load', function () {
            setTimeout(downloadPdf, 500);
        });

        document.getElementById('btnDownload').addEventListener('click', downloadPdf);
    })();
</script>