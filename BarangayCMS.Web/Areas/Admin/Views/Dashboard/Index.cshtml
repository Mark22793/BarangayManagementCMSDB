@model BarangayManagementSystem.Areas.Admin.Models.AdminDashboardViewModel

@{
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Panel - Dashboard Overview";
}

<!-- Welcome Banner -->
<div class="welcome-banner">
    <span class="welcome-banner__eyebrow">Welcome Back,</span>
    <h2 class="welcome-banner__title">Administrator!</h2>
    <p class="welcome-banner__text">This dashboard allows efficient monitoring and management of barangay operations, resident records, and documentation tracking.</p>
</div>

<!-- 🌟 SHORT & CLEAN DISASTER ALERT BANNER (PIC #2 STYLE) -->
@if (!string.IsNullOrEmpty(Model.ActiveDisasterAlert))
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center shadow-sm border-0 rounded-3 my-3 px-3 py-2" style="background-color: #fde8e8; color: #e02424;">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle text-danger fs-5"></i>
            <span style="font-size: 0.95rem;">@Model.ActiveDisasterAlert</span>
        </div>
        <a href="/Admin/Disaster" class="text-danger fw-semibold text-decoration-none d-flex align-items-center gap-1" style="font-size: 0.9rem;">
            View <i class="bi bi-arrow-right"></i>
        </a>
    </div>
}

<!-- Counters Row (DYNAMIC DATA FROM DATABASE) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-people-fill"></i></div>
            <div>
                <p class="stat-card__label">Total Residents</p>
                <p class="stat-card__value">@Model.TotalResidents.ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-chat-left-text-fill"></i></div>
            <div>
                <p class="stat-card__label">Pending Complaints</p>
                <p class="stat-card__value">@Model.PendingComplaints.ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-file-earmark-text-fill"></i></div>
            <div>
                <p class="stat-card__label">Certificates Handled</p>
                <p class="stat-card__value">@Model.CertificatesHandled.ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a href="/Admin/Messages?status=Unread" class="text-decoration-none text-reset">
            <div class="stat-card position-relative">
                <div class="stat-card__icon"><i class="bi bi-inbox-fill"></i></div>
                <div>
                    <p class="stat-card__label">Unread Messages</p>
                    <p class="stat-card__value">@Model.UnreadMessages.ToString("N0")</p>
                </div>
                @if (Model.UnreadMessages > 0)
                {
                    <span class="badge rounded-pill bg-danger position-absolute top-0 end-0 m-2">Bago</span>
                }
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card__icon"><i class="bi bi-cpu-fill"></i></div>
            <div>
                <p class="stat-card__label">System Engine</p>
                <p class="stat-card__value text-success">@Model.SystemStatus</p>
            </div>
        </div>
    </div>
</div>